APP_NAME="PDF Toolkit"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# PDF Toolkit
# ---------------------------------------------------------------------------
# Temporary files (outside the public folder) and their lifetime in minutes
PDF_JOB_TTL=30
PDF_DOWNLOADED_TTL=5
PDF_MAX_UPLOAD_MB=100
PDF_MAX_FILES=30
PDF_MAX_PAGES=1000
PDF_PROCESS_TIMEOUT=300

# "browser" = process in the visitor's browser when possible, "server" = prefer server
PDF_ENGINE_PREFERENCE=browser

# Queue for heavy jobs. Keep QUEUE_CONNECTION=sync without a worker,
# use "database" (or redis) + `php artisan queue:work --queue=pdf,default` in production.
PDF_QUEUE_NAME=pdf

# Optional open-source binaries (leave empty to auto-detect)
QPDF_PATH=
GHOSTSCRIPT_PATH=
PDFTOTEXT_PATH=
PDFTOPPM_PATH=
PDFIMAGES_PATH=
PDFTOHTML_PATH=
LIBREOFFICE_PATH=
TESSERACT_PATH=

# Translation: none | libretranslate | argos
TRANSLATION_DRIVER=none
LIBRETRANSLATE_URL=http://127.0.0.1:5000
LIBRETRANSLATE_API_KEY=
ARGOS_TRANSLATE_PATH=argos-translate

# Browser OCR language data (tesseract.js). Use your own server to avoid the CDN.
# OCR_BROWSER_LANG_PATH=/tessdata

# Admin panel URL path (change it to something hard to guess)
ADMIN_PATH=admin

# Security
SECURITY_HSTS=false
SECURITY_CSP=false
TRUSTED_PROXIES=127.0.0.1
